DATABASE_URL=postgres://lso:lso@localhost:5432/lso
REDIS_URL=redis://localhost:6379/0
API_PORT=3001
WEB_PORT=3000
LOG_LEVEL=info
NODE_ENV=development

CRAWLER_MAX_PAGES=100
CRAWLER_MAX_DEPTH=3
CRAWLER_CONCURRENCY=2
CRAWLER_TIMEOUT=10000
CRAWLER_ALLOW_LOCALHOST=false
CRAWLER_ENGINE=playwright

AUDIT_TIMEOUT=300000
AUDIT_RULESET_VERSION=seo-v1
PERFORMANCE_ENABLED=false

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
AI_ENABLED=true

REPORT_DIRECTORY=./reports
DISCOVERY_PROVIDER=imported

VITE_API_URL=http://localhost:3001
# Optional: bake a cloud URL into the APK at build time (e.g. https://lso-optimizer-you.fly.dev)
VITE_CLOUD_API_URL=https://lso-optimizer-api.onrender.com
