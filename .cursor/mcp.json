{
  "mcpServers": {
    "redis": {
      "command": "py",
      "args": [
        "-3",
        "-m",
        "uv",
        "tool",
        "run",
        "--from",
        "redis-mcp-server==0.5.1",
        "redis-mcp-server",
        "--url",
        "redis://localhost:6379/0"
      ]
    },
    "localsite-optimizer": {
      "command": "npx",
      "args": [
        "--yes",
        "pnpm@10.14.0",
        "--filter",
        "@lso/mcp",
        "start"
      ],
      "cwd": "C:\\Users\\thewi\\LocalSiteOptimizer"
    }
  }
}
